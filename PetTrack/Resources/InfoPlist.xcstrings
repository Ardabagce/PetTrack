    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack nutzt die Kamera, um Tierarztberichte zu scannen und Fotos deines Tieres aufzunehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack usa la cámara para escanear informes veterinarios y hacer fotos de tu mascota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack utilise l'appareil photo pour scanner les comptes rendus vétérinaires et photographier votre animal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack gebruikt de camera om dierenartsrapporten te scannen en foto's van je huisdier te maken."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack lässt dich Fotos deines Tieres und von Tierarztberichten auswählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack te permite elegir fotos de tu mascota y de informes veterinarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PetTrack vous permet de choisir des photos de votre animal et de comptes rendus vétérinaires."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met PetTrack kun je foto's van je huisdier en van dierenartsrapporten kiezen."
          }
        }
      }
    }
  },
  "version": "1.0"
}
