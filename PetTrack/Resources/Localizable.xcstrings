          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ voor %2$@ moet vandaag."
          }
        }
      }
    },
    "%@ free trial": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis testen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratis de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit de %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gratis proberen"
          }
        }
      }
    },
    "%@ free, then %@ per %@. Renews automatically until cancelled in Settings at least 24 hours before the end of the period.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gratis, danach %2$@ pro %3$@. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf in den Einstellungen gekündigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gratis, después %2$@ por %3$@. Se renueva automáticamente salvo que lo canceles en Ajustes al menos 24 horas antes del final del periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gratuits, puis %2$@ par %3$@. Renouvellement automatique sauf résiliation dans Réglages au moins 24 heures avant la fin de la période."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gratis, daarna %2$@ per %3$@. Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de periode opzegt in Instellingen."
          }
        }
      }
    },
    "%@ per %@. Renews automatically until cancelled in Settings at least 24 hours before the end of the period.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pro %2$@. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ablauf in den Einstellungen gekündigt."
