    "%@ for %@ is due in 7 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ für %2$@ ist in 7 Tagen fällig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vacuna %1$@ de %2$@ vence en 7 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vaccin %1$@ de %2$@ est dû dans 7 jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ voor %2$@ moet over 7 dagen."
          }
        }
      }
    },
    "%@ for %@ is due today.": {
      "localizations": {
        "de": {
          "stringUnit": {
