    "Track a rash, lump or limp day by day and show your vet the whole story.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge Rötung, Knubbel oder Lahmen Tag für Tag und zeige der Praxis den ganzen Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
