    "Connect a device and every dispensed meal or water refill is added to %@'s log automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde ein Gerät und jede ausgegebene Mahlzeit oder Wasserfüllung wird automatisch in %@s Protokoll übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un dispositivo y cada ración o recarga de agua se añadirá automáticamente al registro de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un appareil : chaque repas distribué ou remplissage d'eau est ajouté automatiquement au journal de %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind een apparaat en elke uitgegeven maaltijd of waterbeurt wordt automatisch aan het logboek van %@ toegevoegd."
          }
        }
      }
    },
