    "A complete PDF health passport: vaccines, visits, weight, medication and emergency details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vollständiger Gesundheitspass als PDF: Impfungen, Besuche, Gewicht, Medikamente und Notfalldaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pasaporte de salud completo en PDF: vacunas, visitas, peso, medicación y datos de emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passeport santé complet en PDF : vaccins, visites, poids, médicaments et infos d'urgence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een compleet gezondheidspaspoort als pdf: vaccinaties, bezoeken, gewicht, medicatie en noodgegevens."
          }
        }
      }
    },
    "A health passport for the ones who can't keep their own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gesundheitspass für die, die ihren eigenen nicht führen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pasaporte de salud para quienes no pueden llevar el suyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passeport santé pour ceux qui ne peuvent pas tenir le leur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gezondheidspaspoort voor wie het zelf niet kan bijhouden."
          }
        }
      }
    },
