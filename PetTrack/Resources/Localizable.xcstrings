        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ por %2$@. Se renueva automáticamente salvo que lo canceles en Ajustes al menos 24 horas antes del final del periodo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ par %2$@. Renouvellement automatique sauf résiliation dans Réglages au moins 24 heures avant la fin de la période."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ per %2$@. Wordt automatisch verlengd tenzij je minstens 24 uur voor het einde van de periode opzegt in Instellingen."
