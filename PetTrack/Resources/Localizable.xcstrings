    "Any device that works with Apple Shortcuts or Home automations can log a feeding with the “Log a feeding” action – no vendor integration needed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät, das mit Kurzbefehlen oder Home-Automationen funktioniert, kann mit der Aktion „Fütterung erfassen“ eine Fütterung protokollieren – ohne Herstellerintegration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier dispositivo compatible con Atajos o automatizaciones de Casa puede registrar una comida con la acción «Registrar comida», sin integración del fabricante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout appareil compatible avec Raccourcis ou les automatisations Maison peut noter un repas avec l'action « Noter un repas », sans intégration du fabricant."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk apparaat dat met Opdrachten of Woning-automatiseringen werkt, kan een voerbeurt loggen met de actie ‘Voerbeurt loggen’ – zonder integratie van de fabrikant."
          }
        }
      }
