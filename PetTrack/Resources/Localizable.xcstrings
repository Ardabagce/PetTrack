    "Works with reports, invoices and vaccination certificates in English, Spanish, German, French and Dutch. Text is recognized on your device and never uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert mit Berichten, Rechnungen und Impfnachweisen auf Englisch, Spanisch, Deutsch, Französisch und Niederländisch. Der Text wird auf deinem Gerät erkannt und nie hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con informes, facturas y certificados de vacunación en inglés, español, alemán, francés y neerlandés. El texto se reconoce en tu dispositivo y nunca se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec comptes rendus, factures et certificats de vaccination en anglais, espagnol, allemand, français et néerlandais. Le texte est reconnu sur votre appareil et jamais envoyé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt met rapporten, facturen en vaccinatiebewijzen in het Engels, Spaans, Duits, Frans en Nederlands. Tekst wordt op je apparaat herkend en nooit geüpload."
          }
        }
      }
    },
