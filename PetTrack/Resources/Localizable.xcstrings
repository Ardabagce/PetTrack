    "Vets usually recommend switching over 7–10 days. Take it slower for sensitive stomachs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tierärzte empfehlen meist eine Umstellung über 7–10 Tage. Bei empfindlichem Magen langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los veterinarios suelen recomendar hacer el cambio en 7–10 días. Más despacio si el estómago es sensible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vétérinaires recommandent souvent une transition sur 7 à 10 jours. Plus lentement pour les estomacs sensibles."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dierenartsen raden meestal 7–10 dagen aan. Doe het rustiger bij een gevoelige maag."
