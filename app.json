{
  "expo": {
    "name": "PetTrack",
    "slug": "pettrack",
    "version": "1.0.0",
    "scheme": "pettrack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pettrack.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "PetTrack uses the camera to scan vet reports and to photograph your pet and symptoms.",
        "NSPhotoLibraryUsageDescription": "PetTrack lets you pick photos of your pet and of vet reports.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "es",
          "de",
          "fr",
          "nl"
        ]
      }
    },
    "android": {
      "package": "com.pettrack.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1D3529"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false,
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#CF5F3B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PetTrack lets you pick photos of your pet and of vet reports.",
          "cameraPermission": "PetTrack uses the camera to scan vet reports and to photograph your pet and symptoms."
        }
      ]
    ],
    "locales": {},
    "extra": {
      "apiUrl": ""
    }
  }
}